library(tidyverse)
#### hmd data ####
data_hmd_raw = readRDS(
"~/Documents/GitHub/clustering-mortality-two-step/data/blv-data/blv-qx-m-1960-2019-75.rds"
)
select = dplyr::select
data_hmd = data_hmd_raw$df %>%
select(country, year, age, qx) %>%
pivot_wider(names_from = age, values_from = qx)
data_hmd = list(
id = data_hmd$country,
time = data_hmd$year,
y = data_hmd %>%
select(-country, -year) %>%
as.matrix() %>%
logit()
)
y = data_hmd$y
id = data_hmd$id
time = data_hmd$time
#### hmd data ####
data_wpp_raw = readRDS(
"~/Documents/GitHub/clustering-mortality-two-step/data/qx-wpp-male-quality-1960-2019-80.rds"
)
