library(tidyverse)
data_wpp_raw = readRDS(
"~/Documents/GitHub/clustering-mortality-two-step/data/blv-data/wpp/blv-qx-wpp-male-quality-1960-2019-80.rds"
)
data_wpp = data_wpp_raw$df %>%
select(country, year, age, qx) %>%
pivot_wider(names_from = age, values_from = qx)
data_wpp = list(
id = data_wpp$country,
time = data_wpp$year,
y = data_wpp %>%
select(-country, -year) %>%
as.matrix() %>%
logit()
)
#### HMD data ####
data_hmd_raw = readRDS(
"~/Documents/GitHub/clustering-mortality-two-step/data/blv-data/blv-qx-m-1960-2019-75.rds"
)
data_hmd_raw$df %>%
filter(country %in% c("Slovakia", "Latvia", "Estonia")) %>%
filter(age %in% c(30, 40, 50)) %>%
ggplot(aes(x=year, y=logit(qx), color=country, group = country)) +
geom_point() +
geom_line() +
facet_wrap(. ~ age, scales = "free")
data_hmd = data_hmd_raw$df %>%
select(country, year, age, qx) %>%
pivot_wider(names_from = age, values_from = qx)
data_hmd = list(
id = data_hmd$country,
time = data_hmd$year,
y = data_hmd %>%
select(-country, -year) %>%
as.matrix() %>%
logit()
)
K = 2
G = 10
M = 10
center = TRUE
scale = FALSE
n_basis = 10
theta_spline_penalty = 1
theta_intercept_penalty = 1
z_spline_penalty = 1
z_intercept_penalty = 1
w_dirichlet = 1
model_data = create_model_data(
y = data_hmd$y,
id = data_hmd$id,
time = data_hmd$time,
K = K,
G = G,
M = M,
center = center,
scale = scale,
n_basis = n_basis,
theta_spline_penalty = theta_spline_penalty,
theta_intercept_penalty = theta_intercept_penalty,
z_spline_penalty = z_spline_penalty,
z_intercept_penalty = z_intercept_penalty,
w_dirichlet = w_dirichlet
)
init_list = create_init_values(model_data)
init_list$theta %>%
as.data.frame() %>%
mutate(z = init_list$z) %>%
ggplot(aes(x=V1, y=V2, color=factor(z))) +
geom_point()
data.frame(
time = model_data$data$time,
id = model_data$data$id,
z = init_list$z
) %>%
ggplot(aes(x=time, y=id, fill=factor(z))) +
geom_tile(color="black")
init_list$w %>% sort()
iters = 3000
burn_in = 1000
thin = 10
alpha_prior = "normal"
init_list = NULL
devtools::load_all()
fit = single_run(
model_data = model_data,
iters = iters,
burn_in = burn_in,
thin = thin,
alpha_prior = alpha_prior,
seed = 1
)
