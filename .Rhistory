create_dummy = function(z, G) {
if(G != 1) {
#Z = fast_dummy_dense(z, G)
z = factor(z, levels = 1:G)
Z = as.matrix(Matrix::sparse.model.matrix(~ -1 + z))
}else{
Z = matrix(1, nrow = length(z), ncol = 1)
}
return(Z)
}
