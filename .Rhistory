library(tidyverse)
#### HMD data ####
data_hmd_raw = readRDS(
"~/Documents/GitHub/clustering-mortality-two-step/data/blv-data/blv-qx-m-1960-2019-75.rds"
)
data_hmd_raw$df %>%
filter(country %in% c("Slovakia", "Latvia", "Estonia")) %>%
filter(age %in% c(30, 40, 50)) %>%
ggplot(aes(x=year, y=logit(qx), color=country, group = country)) +
geom_point() +
geom_line() +
facet_wrap(. ~ age, scales = "free")
data_hmd = data_hmd_raw$df %>%
select(country, year, age, qx) %>%
pivot_wider(names_from = age, values_from = qx)
data_hmd = list(
id = data_hmd$country,
time = data_hmd$year,
y = data_hmd %>%
select(-country, -year) %>%
as.matrix() %>%
logit()
)
K = 2
