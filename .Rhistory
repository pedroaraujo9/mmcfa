)
pre_run$sample_list$H %>% plot()
pre_run$sample_list$H_active %>% plot()
cluster_size = lapply(1:nrow(pre_run$sample_list$z), function(i) {
unique(pre_run$sample_list$z[i, ]) %>% length()
}) %>% do.call(c, .)
plot(cluster_size, type="l")
cluster_d = lapply(1:nrow(pre_run$sample_list$z), function(i) {
pre_run$sample_list$z[i, ] %>% factor(levels = 1:G) %>% table()
}) %>% do.call(rbind, .)
cluster_d %>%
as.data.frame() %>%
mutate(iter = 1:nrow(cluster_d)) %>%
gather(group, n, -iter) %>%
ggplot(aes(x=iter, y=n, color = group)) +
geom_point() +
geom_line()
pre_run$sample_list$sigma %>% colMeans()
z = pre_run$sample_list$z %>% comp_class()
w = pre_run$sample_list$w %>% comp_class()
cut_int = sort(w) %>% diff() %>% `==`(1) %>% which()
cut_int
pre_run$sample_list$accept %>% colMeans()
data.frame(
id = id,
time = time,
z = z
) %>%
#mutate(id = factor(id, levels = names(sort(w)))) %>%
ggplot(aes(x=time, y=id, fill=factor(z))) +
#geom_hline(yintercept = cut_int + 0.5) +
geom_tile(color="black")
pre_run$sample_list$w %>% comp_class()
pre_run$sample_list$w %>% comp_class() %>% unique()
pre_run$sample_list$w %>% comp_class() %>% sort()
